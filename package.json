{
  "name": "blend-calc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Projector edge-blend calculator \u2014 canvas, array, throw, lens, pixel budget, PDF report and Resolume Arena advanced output export.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4321",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --dry 2>/dev/null || tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "core-js@3.49.0": true
  }
}
